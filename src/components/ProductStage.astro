---
interface Props {
  image?: string;
  alt: string;
}
const { image, alt } = Astro.props;
---

<div class="relative aspect-square bg-linear-to-b from-white to-mist overflow-hidden">
  {image ? (
    <img
      src={image}
      alt={alt}
      class="relative z-10 w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500 ease-out"
    />
  ) : (
    <div class="relative z-10 w-full h-full flex flex-col items-center justify-center gap-3 text-line">
      <svg class="w-16 h-16" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="26" y="26" width="12" height="12" rx="3"/>
        <path d="M26 30 L10 18 M38 30 L54 18 M26 34 L10 46 M38 34 L54 46"/>
        <circle cx="10" cy="18" r="7"/>
        <circle cx="54" cy="18" r="7"/>
        <circle cx="10" cy="46" r="7"/>
        <circle cx="54" cy="46" r="7"/>
      </svg>
      <span class="text-[11px] font-medium tracking-wide uppercase text-ink-soft/60">Foto segera hadir</span>
    </div>
  )}
</div>